      "parameters": {
        "jsCode": "const processed = $('Return Item to Batch Loop').isExecuted ? $('Return Item to Batch Loop').all().map(i => i.json) : [];\nconst deadLetterCount = processed.filter(p => p.next_status === 'DEAD_LETTER').length;\nconst scheduledCount = processed.filter(p => p.next_status === 'RETRY_SCHEDULED').length;\nconst dispatchedCount = processed.filter(p => p.dispatch_now === true).length;\n\nconst msg = processed.length === 0 ? `✨ **WF-13: Retry Manager Sweep Clean!** Koi bhi failed ya due retry job nahi mila.` : [\n  `🩺 **WF-13: Retry Manager (The Healer) Sweep Complete!**`,\n  `• **Total Jobs Evaluated:** ${processed.length}`,\n  `• **Dispatched Immediately to WF-00:** ${dispatchedCount}`,\n  `• **Scheduled with Exponential Backoff:** ${scheduledCount}`,\n  `• **Moved to DEAD_LETTER (Retries >= 3):** ${deadLetterCount}`\n].join('\\n');\n\nreturn [{ json: { ok: true, status: 'RETRY_SWEEP_COMPLETE', workflow_name: 'WF-13', execution_id: $execution.id, total_evaluated: processed.length, dispatched_count: dispatchedCount, scheduled_count: scheduledCount, dead_letter_count: deadLetterCount, processed_jobs: processed, output: msg, text: msg } }];"
