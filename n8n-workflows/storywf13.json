    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $input.item.json || {};\nconst currentRetryCount = Number(job.retry_count || 0);\nconst maxRetries = Number($env.MAX_RETRY_LIMIT || 3);\nconst baseDelayMinutes = Number($env.RETRY_BASE_DELAY_MINS || 15);\nconst nowMs = Date.now();\nconst nowIso = new Date(nowMs).toISOString();\n\nconst isScheduledAndDue = Boolean(job.status === 'RETRY_SCHEDULED' && job.ready_at && new Date(job.ready_at).getTime() <= nowMs);\n\nif (currentRetryCount >= maxRetries && !isScheduledAndDue) {\n  return { json: { job_id: job.id, project_id: job.project_id, episode_no: job.action_payload?.episode_no || 1, action_type: job.action_type || 'GENERATE_EPISODE', previous_retry_count: currentRetryCount, new_retry_count: currentRetryCount, next_status: 'DEAD_LETTER', next_schedule: null, dispatch_now: false, backoff_delay_mins: 0, router_payload: null } };\n}\n\nconst newRetryCount = isScheduledAndDue ? currentRetryCount : (currentRetryCount + 1);\nconst backoffMultiplier = Math.pow(2, currentRetryCount);\nconst backoffDelayMins = baseDelayMinutes * backoffMultiplier;\nconst nextScheduleIso = new Date(nowMs + backoffDelayMins * 60000).toISOString();\n\nconst dispatchNow = Boolean(isScheduledAndDue || job.action_payload?.immediate_retry === true);\nconst nextStatus = dispatchNow ? 'RUNNING' : 'RETRY_SCHEDULED';\n\nconst routerWebhookPayload = {\n  project_id: job.project_id,\n  episode_number: job.action_payload?.episode_no || 1,\n  intent: job.action_type || 'REGENERATE_EPISODE',\n  mode: 'SAVE',\n  rawText: `#retry_job_${job.id} ${job.action_type || 'REGENERATE_EPISODE'} ep ${job.action_payload?.episode_no || 1}`,\n  userPrompt: `Automated WF-13 Surgical Retry #${newRetryCount} for ${job.action_type || 'REGENERATE_EPISODE'}`,\n  sessionId: `wf13_retry_${job.id}_v${newRetryCount}`\n};\n\nreturn { json: { job_id: job.id, project_id: job.project_id, episode_no: job.action_payload?.episode_no || 1, action_type: job.action_type || 'REGENERATE_EPISODE', previous_retry_count: currentRetryCount, new_retry_count: newRetryCount, next_status: nextStatus, next_schedule: dispatchNow ? nowIso : nextScheduleIso, dispatch_now: dispatchNow, backoff_delay_mins: backoffDelayMins, router_payload: routerWebhookPayload } };"
      },
