      "parameters": {
        "jsCode": "const rawItems = $input.all().map(i => i.json);\nconst jobs = [];\n\nfor (const entry of rawItems) {\n  if (Array.isArray(entry)) { for (const r of entry) { if (r && r.id) jobs.push({ json: r }); } }\n  else if (entry && entry.id) { jobs.push({ json: entry }); }\n}\n\nif (jobs.length === 0) { return [{ json: { no_jobs: true, jobs_count: 0 } }]; }\nreturn jobs;"
